FORGEBOT_CONFIG_PATH=forgebot.instance.yml

# GitHub App: replace placeholders; configure exactly ONE private key source.
GITHUB_APP_ID=<numeric-app-id>
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
# Alternative: remove GITHUB_APP_PRIVATE_KEY_PATH and set the full inline PEM.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<private-key-body>\n-----END RSA PRIVATE KEY-----"

# Optional default installation; required for the opt-in smoke test.
# GITHUB_APP_INSTALLATION_ID=<numeric-installation-id>
# FORGEBOT_SMOKE_REPOSITORY=owner/repo
# Smoke tests stay disabled unless explicitly enabled by bun run test:smoke.
